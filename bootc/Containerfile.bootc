# Containerfile.bootc — c12s edge node OS image
#
# Builds a bootc (bootable container) OS image containing the Star agent,
# a systemd unit for it, and greenboot health checks.
#
# Expected build context (tools/bootc/):
#   star              prebuilt linux/amd64 star binary
#                     (CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o star github.com/c12s/star/cmd)
#
# Build:
#   podman build -f Containerfile.bootc -t <registry>/<org>/edge-base:v1.0 .
#
# The image is pushed to Singularity (Zot) and becomes the node's desired
# OS image; Supernova (Phase 3) automates this, bootc-image-builder turns it
# into qcow2/ISO artifacts.

FROM quay.io/fedora/fedora-bootc:45

# marks this image as a bootc OS image (required by bootc-image-builder
# and by bootc tooling that discovers OS images in a registry)
LABEL containers.bootc="1"

# Allow pulling OS images from the lab's HTTP-only Zot registry. Address
# depends on network mode:
#   192.168.122.1 = libvirt default NAT gateway (wormhole-created VMs)
#   10.0.2.2      = QEMU user-net gateway (direct qemu tests)
RUN mkdir -p /etc/containers/registries.conf.d && \
    printf '[[registry]]\nlocation = "192.168.122.1:5001"\ninsecure = true\n[[registry]]\nlocation = "10.0.2.2:5001"\ninsecure = true\n' \
      > /etc/containers/registries.conf.d/local-lab.conf

# cloud-init: the provisioning boundary (D1) injects /var/lib/c12s/node.env
# and first-boot network config through a NoCloud seed (wormhole libvirt
# backend, or any external provisioner). The base image does not ship it.
# greenboot: the health gate — required.d checks run before boot-complete
# and, on repeated failed boots, the rollback trigger set at
# ostree-finalize-staged boots the previous deployment (auto-rollback).
# (greenboot 0.16 on Fedora 45: single package, no greenboot-grub2)
# NOTE: rpm scriptlets do not run `systemctl preset` during image builds, so
# the units must be enabled explicitly — otherwise health checks never run
# and no rollback trigger is ever set (observed on the E2 VM).
RUN dnf -y install cloud-init greenboot && dnf clean all && \
    systemctl enable greenboot-healthcheck.service greenboot-set-rollback-trigger.service

# serial console for headless/lab operation and experiment logging
RUN mkdir -p /usr/lib/bootc/kargs.d && \
    printf 'kargs = ["console=ttyS0,115200"]\n' > /usr/lib/bootc/kargs.d/10-console.toml

ARG STAR_BINARY=star

# human-readable OS version marker, stamped per build; used to verify that a
# bootc switch actually booted the new OS (visible in the VM at
# /usr/share/os-version and in `cockpit image status` once wired)
ARG OS_VERSION=v1
RUN echo "edge-base ${OS_VERSION}" > /usr/share/os-version

# --- star agent -------------------------------------------------------------
COPY ${STAR_BINARY} /usr/local/bin/star
RUN chmod 0755 /usr/local/bin/star

# --- systemd unit -----------------------------------------------------------
COPY systemd/star.service /usr/lib/systemd/system/star.service
RUN systemctl enable star.service

# --- greenboot health checks (required.d: failure => rollback) ---------------
COPY greenboot/01-star-health.sh /etc/greenboot/check/required.d/01-star-health.sh
COPY greenboot/02-cp-reachability.sh /etc/greenboot/check/required.d/02-cp-reachability.sh
RUN chmod 0755 /etc/greenboot/check/required.d/*.sh && \
    chcon -t bin_t /etc/greenboot/check/required.d/*.sh || true

# --- node state dir ----------------------------------------------------------
# /var/lib/c12s persists across every bootc switch and rollback; on first
# boot the node creates nodeid there, cloud-init (or the provisioner) may
# drop node.env for the control plane addresses.
RUN mkdir -p /var/lib/c12s
